  "edges": [
    { "id": "u-e", "from": "user", "to": "entry", "variant": "default" },
    { "id": "e-x", "from": "entry", "to": "extract", "variant": "default" },
    { "id": "x-p", "from": "extract", "to": "prefilter", "variant": "default" },
    { "id": "p-c", "from": "prefilter", "to": "cache", "label": "спросить кэш", "variant": "default" },
    { "id": "c-llm", "from": "cache", "to": "llm", "label": "miss", "variant": "dashed", "role": "branch" },
    { "id": "llm-a", "from": "llm", "to": "apply", "label": "RU-строки", "variant": "emphasis" },
    { "id": "c-a", "from": "cache", "to": "apply", "label": "hit — без LLM", "variant": "emphasis", "role": "return" },
    { "id": "dict-a", "from": "dict", "to": "apply", "label": "dict.json", "variant": "dashed" },
    { "id": "a-o", "from": "apply", "to": "overlay", "label": "Workshop", "variant": "emphasis" },
    { "id": "a-i", "from": "apply", "to": "inplace", "label": "kenshi\\data", "variant": "security" },
    { "id": "a-csv", "from": "apply", "to": "csv", "label": "экспорт", "variant": "dashed" },
    { "id": "csv-o", "from": "csv", "to": "overlay", "label": "overlay install", "variant": "dashed", "role": "branch" },
    { "id": "o-g", "from": "overlay", "to": "game", "variant": "emphasis" },
    { "id": "i-g", "from": "inplace", "to": "game", "variant": "default" }
  ]
}
