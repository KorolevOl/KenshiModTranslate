{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Kenshi RU — конвейер перевода модов (v1.8+)",
    "subtitle": "Workshop-моды → RU-оверлей (EN-оригинал не трогается) · встроенные → in-place + бэкап рядом",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "standard",
    "views": [
      {
        "id": "full-path",
        "label": "Полный конвейер",
        "focus": ["user", "entry", "extract", "prefilter", "cache", "llm", "apply", "overlay", "game"],
        "note": "От запуска .bat до русской строки в игре: извлечение, кэш, LLM, сборка."
      },
      {
        "id": "cache-hit",
        "label": "Повторный перевод (кэш)",
        "focus": ["prefilter", "cache", "apply", "overlay", "game"],
        "note": "Кэш-хит: LLM не зовётся, перевод берётся из state/ — дёшево и мгновенно."
      },
      {
        "id": "outputs",
        "label": "Три способа вывода",
        "focus": ["apply", "overlay", "inplace", "csv", "game"],
        "note": "Workshop → отдельный RU-оверлей; встроенные → в место (бэкап рядом); CSV → правка в Excel."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": { "label": "Вход" },
        "backend": { "label": "Конвейер" },
        "database": { "label": "Хранилище" },
        "cloud": { "label": "LLM" },
        "security": { "label": "Защита / in-place" },
        "external": { "label": "Вне системы" }
      }
    }
  },
  "lanes": [
    { "id": "input", "label": "1. Вход — пользователь" },
    { "id": "pipeline", "label": "2. Конвейер — Python + C# (cli.py)" },
    { "id": "store", "label": "3. ИИ и хранилище" },
    { "id": "output", "label": "4. Результат — в игру" }
  ],
  "phases": [
    { "id": "intake", "label": "Вход", "fromCol": 0, "toCol": 1 },
    { "id": "translate", "label": "Перевод", "fromCol": 2, "toCol": 4, "variant": "emphasis" },
    { "id": "build", "label": "Сборка и вывод", "fromCol": 5, "toCol": 5 }
  ],
  "groups": [
    { "id": "overlay_out", "label": "Workshop: EN-оригинал не трогается", "lane": "output", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "inplace_out", "label": "kenshi\\data: in-place + бэкап рядом", "lane": "output", "fromCol": 3, "toCol": 3, "variant": "security" }
  ],
  "mainPath": ["user", "entry", "extract", "prefilter", "cache", "llm", "apply", "overlay", "game"],
  "nodes": [
    { "id": "user", "lane": "input", "col": 0, "type": "external", "label": "Пользователь", "sublabel": ".bat / python CLI", "width": 130 },
    { "id": "entry", "lane": "input", "col": 1, "type": "frontend", "label": "Точки входа", "sublabel": "translate · search · verify", "width": 130 },
    { "id": "extract", "lane": "pipeline", "col": 2, "type": "backend", "label": "Извлечение", "sublabel": "Program.cs extract → EN", "width": 130 },
    { "id": "prefilter", "lane": "pipeline", "col": 3, "type": "security", "label": "Предфильтр", "sublabel": "skip · reuse · game-skip", "width": 130 },
    { "id": "apply", "lane": "pipeline", "col": 4, "type": "backend", "label": "Сборка", "sublabel": "Program.cs apply + dict.json", "width": 130 },
    { "id": "cache", "lane": "store", "col": 3, "type": "database", "label": "Кэш state/", "sublabel": "hits / miss по строкам", "width": 130 },
    { "id": "llm", "lane": "store", "col": 4, "type": "cloud", "label": "LLM (любой API)", "sublabel": "EN → RU, словарь в промпте", "width": 130 },
    { "id": "dict", "lane": "store", "col": 5, "type": "database", "label": "Словари", "sublabel": "dict.json · exclude.txt", "width": 130 },
    { "id": "csv", "lane": "output", "col": 2, "type": "database", "label": "CSV ↔ Excel", "sublabel": "<имя>.translate.csv", "width": 130 },
    { "id": "inplace", "lane": "output", "col": 3, "type": "security", "label": "In-place", "sublabel": "бэкап .orig_<hash>.backup", "width": 130 },
    { "id": "overlay", "lane": "output", "col": 4, "type": "backend", "label": "RU-оверлей", "sublabel": "<имя> RUS/<имя> RUS.mod", "width": 140 },
    { "id": "game", "lane": "output", "col": 5, "type": "external", "label": "Игра Kenshi", "sublabel": "__mods.list → RU-строки", "width": 130 }
